\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{../plantilla/latex/unab_reporte}[2026/09/07 Estilo de reportes KODIGO]
\RequirePackage[margin=2.5cm,includefoot,headheight=16pt]{geometry}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{fontspec}
\RequirePackage{needspace}
\newfontfamily\FuenteFirma[Path=../assets/fuentes/]{firma.otf}
\RequirePackage{microtype}
\RequirePackage{setspace}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{colortbl}
\RequirePackage{enumitem}
\RequirePackage{hyperref}
\RequirePackage{listings}
\definecolor{kodigoprimary}{HTML}{43235B}
\definecolor{softgray}{HTML}{F2F2F2}
\definecolor{linegray}{HTML}{D8DEE8}
\definecolor{codegreen}{HTML}{2E7D32}
\definecolor{codegray}{HTML}{6E7781}
\definecolor{codepurple}{HTML}{7B1FA2}
\definecolor{codebg}{HTML}{F6F8FA}

\lstdefinestyle{kodigocode}{
  backgroundcolor=\color{codebg},
  commentstyle=\color{codegreen}\itshape,
  keywordstyle=\color{kodigoprimary}\bfseries,
  numberstyle=\tiny\color{codegray},
  stringstyle=\color{codepurple},
  basicstyle=\ttfamily\footnotesize,
  breakatwhitespace=false,
  breaklines=true,
  captionpos=b,
  keepspaces=true,
  numbers=left,
  numbersep=8pt,
  showspaces=false,
  showstringspaces=false,
  showtabs=false,
  tabsize=2,
  frame=single,
  framerule=0.5pt,
  rulecolor=\color{linegray}
}
\lstset{style=kodigocode}

% Entorno institucional para notas y observaciones
\newenvironment{cajanota}[1][Nota informativa]{%
  \par\vspace{0.3cm}
  \noindent
  \begin{tabularx}{\textwidth}{@{}|X|@{}}
    \hline
    \cellcolor{softgray}\textbf{\color{kodigoprimary}#1}\par\vspace{0.15cm}
}{%
    \\ \hline
  \end{tabularx}
  \par\vspace{0.3cm}
}
\hypersetup{colorlinks=true,linkcolor=kodigoprimary,urlcolor=kodigoprimary,citecolor=kodigoprimary}
\onehalfspacing
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.6em}
\setlength{\emergencystretch}{2em}
\setlist[itemize]{topsep=0.3em,itemsep=0.2em}
\titleformat{\section}{\Large\sffamily\bfseries\color{kodigoprimary}}{\thesection.}{0.6em}{}
\titleformat{\subsection}{\large\sffamily\bfseries\color{kodigoprimary}}{\thesubsection}{0.6em}{}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\sffamily\color{kodigoprimary}\TituloCorto}
\fancyfoot[C]{\small\sffamily\color{kodigoprimary}Reporte académico\hfill\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\newcommand{\logoreporte}[2]{%
  \includegraphics[width=#2,height=2cm,keepaspectratio]{#1}%
}
\providecommand{\NombreAutor}{\NombreFirma}
\newcommand{\portadareporte}{%
  \hypersetup{pageanchor=false}
  \begin{titlepage}
  \singlespacing
  \begin{center}
    \vspace*{0.6cm}
    \includegraphics[width=8cm,height=2.8cm,keepaspectratio]{../assets/institucional/logo.png}\par
    \vspace{0.7cm}
    {\large\sffamily\Institucion\par}
    \vfill
    {\small\sffamily\color{kodigoprimary}ACTIVIDAD INDIVIDUAL · SEMANA 2\par}
    \vspace{0.4cm}
    {\fontsize{24}{30}\selectfont\sffamily\bfseries\color{kodigoprimary}\TituloTrabajo\par}
    \vspace{0.6cm}
    {\large\SubtituloTrabajo\par}
    \vfill
    {\sffamily\bfseries\Asignatura\par}
    \vspace{0.6cm}
    {\large\NombreAutor\par}
    \vspace{0.25cm}
    {\sffamily Estudiante\par}
    \vfill
    {\small Reporte de desarrollo, prompts y validación\par}
    \vspace{0.3cm}
    {\small\url{https://academy.kodigo.org/}\par}
    \vspace*{0.5cm}
  \end{center}
  \end{titlepage}
  \hypersetup{pageanchor=true}
}

% Únicamente el nombre en la tipografía manuscrita proporcionada.
\newcommand{\firmareporte}{%
  \par\Needspace{2.5cm}
  \vspace{0.7cm}
  \begin{flushright}
    {\color{kodigoprimary}\FuenteFirma\fontsize{30}{38}\selectfont\NombreFirma\par}
  \end{flushright}
}
